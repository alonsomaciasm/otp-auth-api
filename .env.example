# General Settings
PROJECT_NAME=Enterprise OTP Auth API
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
API_PORT=8000
TZ=America/Mexico_City

# Feature Flags
ENABLE_PUBLIC_REGISTRATION=true

# -----------------------------------------------------------------
# DATABASE CONFIGURATION:
# Primary Engine: SQLite AsyncIO in WAL (Write-Ahead Logging) mode.
# -----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////app/data/sql_app.db

# Storage & Redis:
USE_REDIS=false
REDIS_URL=redis://redis:6379/0

# Security & JWT Tokens
JWT_SECRET_KEY=SUPER_SECRET_CHANGE_ME_IN_PRODUCTION_KEY_32BYTES_MIN!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_SECONDS=900
OTP_TYPE=numeric
OTP_LENGTH=6

# Rate Limiting & Performance Payload Limit
RATE_LIMIT_REQUEST_OTP_PER_MIN=3
JSON_PARSER_ENGINE=msgspec

# =================================================================
# OTP DELIVERY CHANNEL CONFIGURATION
# Set OTP_CHANNEL=smtp for real email sending or console for Dev Mode
# =================================================================
OTP_CHANNEL=smtp

# -----------------------------------------------------------------
# OPCIÓN 1 (ACTIVA - RECOMENDADA): Resend SMTP (3,000 correos/mes gratis)
# -----------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=resend
SMTP_PASSWORD=re_tu_api_key_aqui
SMTP_FROM_EMAIL=onboarding@resend.dev

# -----------------------------------------------------------------
# OPCIÓN 2 (COMENTADA): Brevo SMTP (300 correos/día gratis - 9,000/mes)
# -----------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=tu_correo_registro@dominio.com
# SMTP_PASSWORD=xsmtpsib-tu_clave_smtp_brevo
# SMTP_FROM_EMAIL=tu_correo_registro@dominio.com

# -----------------------------------------------------------------
# OPCIÓN 3 (COMENTADA): Mailtrap SMTP (Entorno de Pruebas virtual)
# -----------------------------------------------------------------
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_TLS=true
# SMTP_USER=tu_usuario_mailtrap
# SMTP_PASSWORD=tu_password_mailtrap
# SMTP_FROM_EMAIL=noreply@otp-auth.dev

# -----------------------------------------------------------------
# OPCIÓN 4 (COMENTADA): Gmail SMTP (500 correos/día con Contraseña de Aplicación)
# -----------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM_EMAIL=tu_cuenta@gmail.com

# -----------------------------------------------------------------
# OPCIÓN 5 (COMENTADA): Modo Consola / Developer (Visualización en Logs & Dashboard)
# -----------------------------------------------------------------
# OTP_CHANNEL=console

# =================================================================
# EMAIL TEMPLATE CUSTOMIZATION (UI/UX & Text Variables)
# =================================================================
EMAIL_SUBJECT_PREFIX=Código de Verificación
EMAIL_BRAND_NAME=Autenticación de Seguridad
EMAIL_BRAND_SLOGAN=Zero-Trust Multi-Factor Authentication
EMAIL_GREETING=Hola,
EMAIL_BODY_TEXT=Usa el siguiente código de verificación de un solo uso para completar tu inicio de sesión:
EMAIL_SECURITY_NOTICE=🔒 Aviso de Seguridad: Si no intentaste iniciar sesión, ignora este mensaje. Nunca compartas este código con nadie; nuestro personal jamás te lo solicitará.
EMAIL_FOOTER_TEXT=Este mensaje fue generado automáticamente. © 2026 Enterprise Zero-Trust Security Architecture.
